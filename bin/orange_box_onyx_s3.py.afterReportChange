#!/usr/bin/env python3

"""Script to manage Onyx metadata and S3 file transfer for the Orange Box, run
when all Orange Box analysis modules have successfully completed.
The overall process is split into separate tasks, such that Onyx and S3
calls can have distinct retry strategies within the Nextflow pipeline.

Tasks:
(1) FirstWriteToOnyx
*  Loads JSON output from completed analysis module into an OnyxAnalysis
   helper object.
*  Checks JSON integrity.
*  Creates provisional Onyx record, storing the analysis_id that Onyx returns.
*  Creates a temp file containing the analysis_id required for later tasks.

(2) S3Upload
*  Reads in analysis_id from analysis_id file generated by FirstWriteToOnyx.
*  Transfers results to relevant S3 bucket.
*  Creates skeleton OnyxAnalysis helper object containing S3 output location.
*  Writes that object to a JSON file.

(3) FinalOnyxUpdate
*  Reads in analysis_id from analysis_id file generated by FirstWriteToOnyx.
*  Loads JSON generated by S3Upload into an OnyxAnalysis helper object.
*  Updates Onyx with S3 output location.
*  Generates a file containing the analysis_id used as a checkpoint for the
   module having successfully completed all pre-publish Onyx/S3 steps.

N.B. The Onyx record is not published at this point: this will be performed
separately by a separate script once all modules have successfully completed
Onyx updates and S3 uploads, to prevent partial Onyx records being published.

The full process requires the Python script to be run 3 times, once per task.
e.g.
python orange_box_onyx_s3.py  --climb_id ID-12345678  \
  --json ID-12345678_qc_metrics_analysis_fields.json  --server mscape  \
  --bucket orange_box_outputs  --orange_box_module QC  --task FirstWriteToOnyx

python orange_box_onyx_s3.py  --climb_id ID-12345678  \
  --json ID-12345678_qc_metrics_analysis_fields.json  --server mscape  \
  --bucket orange_box_outputs  --orange_box_module QC  --task S3Upload  \
  --files_to_upload ID-12345678_qc_results.json

python orange_box_onyx_s3.py  --climb_id ID-12345678  \
  --json ID-12345678.QC.s3_output_location.json  --server mscape  \
  --bucket orange_box_outputs  --orange_box_module QC  --task FinalOnyxUpdate


Command line variables/options required:
  --climb_id: climb_id
  --json: path to approppriate JSON file,
  --server:  {mscape, synthscape}
  --bucket:  S3 bucket to use, set in Nextflow parameters
  --orange_box_module:  name of orange box module, defined in Nextflow code
  --files_to_upload:  comma-separated list of files to upload
  --task: {FirstWriteToOnyx, S3Upload, FinalOnyxUpdate}

Outputs:
  temp analysis_id_file:    ${climb_id}.${orange_box_module}.temp.analysis_id
  S3_output_location json:  ${climb_id}.${orange_box_module}.s3_location.json
  final analysis_id_file:   ${climb_id}.${orange_box_module}.analysis_id
"""


from onyx_analysis_helper import onyx_analysis_helper_functions as oa
from onyx_analysis_helper import s3_functions as s3f
import argparse
import logging
import sys
from pathlib import Path
import json

def get_args():
    """Parse command line arguments"""
    parser = argparse.ArgumentParser(
        prog="Orange Box Onyx analysis updater and S3 file uploader",
        description="""Script run after Orange Box module has created an
        OnyxAnalysis JSON file. On successful completion will have created
        an Onyx analysis on Onyx, uploaded all required files to S3 and
        updated the final Onyx analysis with S3 file/folder locations.
        """
    )
    parser.add_argument("--climb_id", "-c", type=str, required=True, help="Climb ID")
    parser.add_argument("--json", "-j", type=str, required=True, help="Onyx Analysis JSON file")
    parser.add_argument(
        "--server",
        "-s",
        type=str,
        required=True,
        choices=["mscape", "synthscape"],
        help="Specify server code is being run on",
    )
    parser.add_argument("--bucket", "-b", type=str, required=True, help="Bucket name (n.b. must not include '/' characters)")
    parser.add_argument("--orange_box_module", "-m", type=str, required=True, help="Orange Box module name")
    parser.add_argument("--task", "-t", type=str, required=True, help="Specify task to run e.g. FirstWriteToOnyx, S3Upload, FinalOnyxUpdate")
    parser.add_argument("--files_to_upload", "-f", type=str, required=False, help="Comma-separated list of files to upload to S3")

    return parser.parse_args()


def set_up_logger(stdout_file):
    """Creates logger for component - all logging messages go to stdout
    log file, error messages also go to stderr log. If component runs
    correctly, stderr is empty.
    """
    logger = logging.getLogger()
    logger.setLevel(logging.DEBUG)
    formatter = logging.Formatter("[%(asctime)s] %(levelname)s: %(message)s")

    out_handler = logging.FileHandler(stdout_file, mode="a")
    out_handler.setFormatter(formatter)
    logger.addHandler(out_handler)

    return logger


### REUSABLE READ/WRITE ANALYSIS_ID FILE FUNCTIONS
def write_analysis_id_file(climb_id, orange_box_module, analysis_id, analysis_stage):
    exitcode = 0
    if analysis_stage == "final":
        analysis_id_file = f"{climb_id}.{orange_box_module}.analysis_id"
    else:
        analysis_id_file = f"{climb_id}.{orange_box_module}.temp.analysis_id"

    try:
        with open(analysis_id_file, "w") as outfile:
            outfile.write(f"{analysis_id}")
    except:
        logging.error("Unable to write to analysis_id_file: %s using inputs: %s, %s, %s, %s",
                      analysis_id_file, climb_id, orange_box_module, analysis_id, analysis_stage)
        exitcode = 1

    return exitcode


def read_analysis_id_from_file(analysis_id_file):
    exitcode = 0
    try:
        with open(analysis_id_file, "r") as infile:
            lines = [line.rstrip() for line in infile]
            # Need code to catch if for some reason the analysis_id_file has >1 analysis_id in it
            # e.g. something like if len(lines) != 1: crash with exitcode=1
            if len(lines) == 1:
                analysis_id = lines[0]
            else:
                logging.error("Analysis_id_file should contain 1 line: %s contained %s lines", analysis_id_file, len(lines))
                exitcode = 1
                return None, exitcode
    except:
        logging.error("Couldn't read analysis_id from file: %s", analysis_id_file)
        exitcode = 1
        return None, exitcode

    return analysis_id, exitcode


def check_onyx_json(onyx_analysis, publish_analysis):
    """Function to check onyx analysis JSON and log errors.
    Requires publish_analysis: {True,False} to determine whether
    report and/or outputs field(s) are required in the Onyx JSON
    e.g.
    check_status_list = onyx_analysis.check_analysis_object(publish_analysis=False)
    """
    onyx_fail = 0
    check_status_list = onyx_analysis.check_analysis_object(publish_analysis=publish_analysis)
    if len(check_status_list) == 2:
        if check_status_list[0]:
            logging.error("Missing >=1 required fields in Onyx analysis object: check log for details")
        if check_status_list[1]:
            logging.error("Invalid attribute in Onyx analysis object: check log for details")
        if any(status for status in check_status_list):
            onyx_fail = 1
    else:
        # To catch the unlikely event that the Onyx helper function has failed to generate a list of two statuses for missing and/or invalid attributes.
        logging.error("Onyx helper function check_analysis.object() failed to correctly generate status list")
        onyx_fail = 1

    return(check_status_list, onyx_fail)


### TASKS
def first_write_to_onyx(climb_id, json, server, orange_box_module):
    # Load in Onyx analysis JSON file - all analysis finished at this point but nothing uploaded to Onyx/S3 so far...
    exitcode = 0
    onyx_analysis = oa.OnyxAnalysis()
    try:
        onyx_analysis.read_analysis_from_json(json)
    except:
        logging.error("Couldn't read analysis from json: %s", json)
        exitcode = 1
        return exitcode

    # Check integrity of JSON
    onyx_status_list, exitcode = check_onyx_json(onyx_analysis, publish_analysis=False)
    if exitcode != 0:
        logging.error("JSON file failed check_onyx_json integrity test: %s", json)
        return exitcode

    # Create a provisional Onyx record and store the analysis_id that it returns

## Commenting this out for the moment so the code will only try "dryrun" Onyx writes.  Switch back when testing complete.
##    analysis_id_json, exitcode = onyx_analysis.write_analysis_to_onyx(server=server, dryrun=False, publish_analysis=False)
    analysis_id_json, exitcode = onyx_analysis.write_analysis_to_onyx(server=server, dryrun=False, publish_analysis=False)
    try:
        analysis_id = analysis_id_json['analysis_id']
    except:
        logging.error("Unable to extract analysis_id from JSON returned from Onyx: %s", analysis_id_json)
        exitcode = 1
        return exitcode

    # Write analysis_id to ${climb_id}.${orange_box_module}.temp.analysis_id for later Onyx update step
    exitcode = write_analysis_id_file(climb_id, orange_box_module, analysis_id, "temp")

    return exitcode


def s3_upload(climb_id, analysis_id_file, bucket, orange_box_module, files_to_upload):
    exitcode = 0
    ### (1) First perform S3 upload step
    # Read analysis_id from temporary analysis_id_file
    analysis_id, exitcode = read_analysis_id_from_file(analysis_id_file)
    if exitcode != 0:
        logging.error("Couldn't read analysis_id from analysis_id file: %s", analysis_id_file)
        return exitcode

    s3_file_list = list()
    local_file_list = files_to_upload.split(',')

    # Upload all files to S3 and store the URIs in s3_file_list
    s3_client = s3f.set_up_s3_client()  # this only needs to be run once
    for file in local_file_list:
        try:
            # N.b. not sure we actually need to make s3_key?
            s3_key = s3f._make_s3_key_name(analysis_id=analysis_id, file_for_upload=file)
            s3_uri, exitcode = s3f.upload_file_to_s3(analysis_id=analysis_id, bucket=bucket, file_for_upload=file, s3_client=s3_client)
            s3_file_list.append(s3_uri)
        except:
            logging.error("S3 transfer failed for: %s using inputs: %s, %s, %s, %s, %s",
                        file, climb_id, analysis_id_file, bucket, orange_box_module, files_to_upload)
            exitcode = 1
            return exitcode

    ### (2) Now add S3 path (to single results file or folder for multiple results files) to OnyxAnalysis object
    # Create an empty Onyx analysis object
    onyx_analysis = oa.OnyxAnalysis()

    # Determine whether Onyx will store an S3 key to a file (single results file) or a "folder" (multiple results files).
    # Code changed as originally the single output file from the QC module was stored in oa.result not oa.outputs.
    # Reports will now be uploaded separately
    if(len(local_file_list) == 1 ):
        s3_output_location = f"{s3_file_list[0]}"
        onyx_analysis.outputs = s3_output_location
    else:
        s3_output_location = f"s3://{bucket}/{analysis_id}"
        onyx_analysis.outputs = s3_output_location

####  N.B. oa.add_output_location() doesn't work with S3 buckets/files :(
####  So have used a workaround to perform same function in the if/else statement above
####  and commented out the following two lines.
####    # Then add S3_output_location to onyx object  n.b. add_output_location returns {True, False}
####    exitcode = onyx_analysis.add_output_location(result_path=s3_output_location)


    # Because we want to keep S3 and Onyx steps separate, we will run update_onyx_analysis_to_onyx() in a separate task and not here.
    # This means we need to export the final JSON containing S3 upload location at this point
    s3_output_location_json = f"{climb_id}.{orange_box_module}.s3_location.json"
    try:
        onyx_analysis.write_analysis_to_json(s3_output_location_json)
    except:
        logging.error("Unable to write s3_location analysis to json: %s using inputs: %s, %s, %s, %s, %s",
                        s3_output_location_json, climb_id, analysis_id_file, bucket, orange_box_module, files_to_upload)
        exitcode = 1
        return exitcode

    return exitcode


def final_onyx_update(climb_id, s3_output_location_json, analysis_id_file, server, orange_box_module):
    """Perform final write of updated OnyxHelper object to Onyx: but don't
    publish yet - we will use a separate script to publish all Orange Box
    analyses together once their Onyx/S3 transfers have completed.
    """

    exitcode = 0

    # Read in analysis_id from analysis_id_file
    analysis_id, exitcode = read_analysis_id_from_file(analysis_id_file)
    if exitcode != 0:
        logging.error("Couldn't read analysis_id from analysis_id file: %s", analysis_id_file)
        return exitcode

    onyx_analysis = oa.OnyxAnalysis()
    # Then read in s3_output_location JSON, created after successful S3 transfer.
    # For modules with no need for S3 upload, just pass the original JSON file to this function instead.
    try:
        onyx_analysis.read_analysis_from_json(s3_output_location_json)
    except:
        logging.error("Couldn't read analysis from json: %s", s3_output_location_json)
        exitcode = 1
        return exitcode

    # Copy final JSON to Onyx
##  Commenting this out for the moment so the code will only try "dryrun" Onyx writes.  Switch back when testing complete.
##    analysis_id, exitcode = onyx_analysis.update_onyx_analysis(server, analysis_id=analysis_id, dryrun=False, publish_analysis=False)
    analysis_id_json, exitcode = onyx_analysis.update_onyx_analysis(server, analysis_id=analysis_id, dryrun=False, publish_analysis=False)
    if exitcode != 0:
        logging.error("Couldn't update Onyx with S3 location for analysis_id: %s using server: %s", analysis_id, server)
        return exitcode

#        try:
#        analysis_id = analysis_id_json.replace("'","\""))['analysis_id'])
#    except:
#        logging.error("Unable to extract analysis_id from JSON returned from Onyx: %s", analysis_id_json)
#        exitcode = 1
#        return exitcode

    # Last step is to write a final analysis_id_file which will be picked up by the PUBLISH script
    # i.e. ${climb_id}.${orange_box_module}.analysis_id
####  Shouldn't the analysis_id be the same as the one loaded in from analysis_id_file, so perhaps we don't need
####  the regex above? Have commented out for now, but perhaps we could do a check to make sure it's the same?
    exitcode = write_analysis_id_file(climb_id, orange_box_module, analysis_id, "final")

    return exitcode


### MAIN
"""
Data flow:
  Assume upstream module has finished analysis and created an OnyxAnalysis JSON file
  Tasks for this script:
  (1) 1st write-to-onyx: no-publish                                 (TASK1)
  (2) getting analysis_id (stored as temp analysis_id file)         (TASK1)
  (3) copy relevant files to S3                                     (TASK2)
  (4) add S3 path to onyxAnalysis object                            (TASK2)
  (5) 2nd write-to-onyx: update to final "ready-to-publish" status  (TASK3)
  (6) write final analysis_id to file - useful (but clunky) checkpoint - needs to be output for all modules to trigger later PUBLISH process (TASK3)

"""
def main():
    args = get_args()

    # Set up log file - if using TASKS, add TASK to logfile name perhaps?  Initially didn't - thought it will make too many log files...
    # But Nextflow doesn't respect Python append and overwrites all logs in the publish dir, ouch...
    log_file = f"{args.climb_id}.{args.orange_box_module}.{args.task}.Orange_Box_Onyx_S3_transfer_log.txt"
    set_up_logger(log_file)

    # Define temporary analysis_id_file
    analysis_id_file = f"{args.climb_id}.{args.orange_box_module}.temp.analysis_id"

    # Identify task to run:
    task_fail = 0
    if(args.task == "FirstWriteToOnyx"):
        task_fail = first_write_to_onyx(args.climb_id, args.json, args.server, args.orange_box_module)

    elif(args.task == "S3Upload"):
        task_fail = s3_upload(args.climb_id, analysis_id_file, args.bucket, args.orange_box_module, args.files_to_upload)

    elif(args.task == "FinalOnyxUpdate"):
        task_fail = final_onyx_update(args.climb_id, args.json, analysis_id_file, args.server, args.orange_box_module)

    else:
        # Error: unknown task
        logging.error("Unknown task: %s", args.task)
        task_fail = 1

    if task_fail != 0:
        logging.error("Task: %s failed.  Check log file for more details.", args.task)
        return task_fail

    # If we get this far, the task should have run to completion
    logging.info("Task %s ran to completion.", args.task)
    return task_fail


if __name__ == "__main__":
    sys.exit(main())
