profiles {
    climb {
        process {
            executor  = 'k8s'
            pod       = [[securityContext: [fsGroupChangePolicy: 'OnRootMismatch', runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000]], [automountServiceAccountToken: false], [nodeSelector: 'hub.jupyter.org/node-purpose=user'], [volumeClaim: "cephfs-shared-team", mountPath: "/shared/team"], [volumeClaim: "cephfs-shared-ro-public", mountPath: "/shared/public", readOnly: true], [ttlSecondsAfterFinished: 60]]
            queueSize = 30
        }
        env {
            ONYX_TOKEN  = System.getenv('ONYX_TOKEN')
            ONYX_DOMAIN = System.getenv('ONYX_DOMAIN')
            AWS_SECRET_ACCESS_KEY = System.getenv('AWS_SECRET_ACCESS_KEY')
            AWS_ACCESS_KEY_ID = System.getenv('AWS_ACCESS_KEY_ID')
            AWS_ENDPOINT_URL = System.getenv('AWS_ENDPOINT_URL')
            AWS_REQUEST_CHECKSUM_CALCULATION = System.getenv('AWS_REQUEST_CHECKSUM_CALCULATION')
        }
        k8s {
            runAsUser           = 1000
            computeResourceType = 'Job'
            cpuLimits           = true
        }
        aws {
            client {
                endpoint          = 'https://s3.climb.ac.uk'
                s3PathStyleAccess = true
            }
        }
    }
    mscape {
        params.server = "mscape"
    }

    synthscape {
        params.server = "synthscape"
    }
}
